#!/usr/bin/env bash
# ralpr - Ralpr CLI v3.0 (Ralph Autonomous Loop for Pull-request Readiness)
# Three-phase architecture: Implementation → Review → Refactor
# Super Loop: Continuous impl→review→refactor pipeline with tmux monitoring
#
# Usage: ralpr <command> [options]
#
# Commands:
#   implementation   Run Phase 1: Implement an issue (no loops)
#   review           Run Phase 2: Review a PR (loops + confidence)
#   refactor         Run Phase 3: Refactor a PR (loops + confidence)
#   loop             Super Loop: continuous impl→review→refactor pipeline
#   setup            Check prerequisites, detect default branch
#   select           Select next ticket (PR or issue)
#   claim            Assign ticket to self
#   branch           Create feature branch/worktree
#   ci               CI operations (wait, logs, status)
#   pr               PR operations (check-conflicts, create, verify)
#   release          Release assignment from ticket

set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points to the real file location
_ralpr_source="${BASH_SOURCE[0]}"
while [[ -L "$_ralpr_source" ]]; do
  _ralpr_dir="$(cd "$(dirname "$_ralpr_source")" && pwd)"
  _ralpr_source="$(readlink "$_ralpr_source")"
  # Handle relative symlink targets
  [[ "$_ralpr_source" != /* ]] && _ralpr_source="$_ralpr_dir/$_ralpr_source"
done
SCRIPT_DIR="$(cd "$(dirname "$_ralpr_source")" && pwd)"
unset _ralpr_source _ralpr_dir
QUERIES_DIR="$SCRIPT_DIR/queries"

# Source common functions
source "$SCRIPT_DIR/lib/common.sh"

# Source config (needed by cmd_select --phase for thresholds)
source "$SCRIPT_DIR/../config/ralpr.config.sh"

# ============================================================================
# HELPER: Check if issue has a "done" PR (passing CI, no unresolved comments)
# ============================================================================
issue_has_done_pr() {
  local issue_num="$1"
  local owner repo
  owner=$(get_owner)
  repo=$(get_repo)

  # Find open PRs that are linked to close this issue
  local linked_prs
  linked_prs=$(gh api graphql -f query="$(cat "$QUERIES_DIR/issue-closing-prs.graphql")" \
    -f owner="$owner" -f repo="$repo" -F issue="$issue_num" \
    --jq '.data.repository.issue.closedByPullRequestsReferences.nodes[].number' 2>/dev/null)

  if [[ -z "$linked_prs" ]]; then
    return 1
  fi

  for pr_num in $linked_prs; do
    local unresolved
    unresolved=$(gh api graphql -f query="$(cat "$QUERIES_DIR/pr-unresolved-threads.graphql")" \
      -f owner="$owner" -f repo="$repo" -F pr="$pr_num" \
      --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' 2>/dev/null || echo "0")

    if [[ "$unresolved" -gt 0 ]]; then
      continue
    fi

    local ci_failed
    ci_failed=$(gh pr view "$pr_num" --json statusCheckRollup \
      --jq '.statusCheckRollup[] | select(.conclusion == "FAILURE") | .conclusion' 2>/dev/null | head -1)

    if [[ -z "$ci_failed" ]]; then
      return 0
    fi
  done

  return 1
}

# Check if an issue has ANY open linked PR (regardless of review/CI state).
# Used to skip issues already being worked on.
_issue_has_open_pr() {
  local issue_num="$1"
  local owner repo
  owner=$(get_owner)
  repo=$(get_repo)

  local linked_prs
  linked_prs=$(gh api graphql -f query="$(cat "$QUERIES_DIR/issue-closing-prs.graphql")" \
    -f owner="$owner" -f repo="$repo" -F issue="$issue_num" \
    --jq '.data.repository.issue.closedByPullRequestsReferences.nodes[].number' 2>/dev/null)

  [[ -n "$linked_prs" ]]
}

# ============================================================================
# SUBCOMMAND: setup
# ============================================================================
cmd_setup() {
  if [[ $# -gt 0 ]]; then
    log_error "Unknown option: $1"
    return 1
  fi

  log_info "Checking prerequisites..."

  if ! check_gh_auth; then
    ralpr_result '{"status":"error","code":"gh_not_auth","message":"GitHub CLI not authenticated"}'
    exit 1
  fi

  if ! check_git_clean; then
    ralpr_result '{"status":"error","code":"dirty_git","message":"Working directory not clean"}'
    exit 2
  fi

  local default_branch
  default_branch=$(get_base_branch)

  if [[ -z "$default_branch" ]]; then
    log_error "No default branch found on remote"
    ralpr_result '{"status":"error","code":"no_default_branch","message":"No default branch configured on GitHub"}'
    exit 3
  fi

  log_info "Default branch: $default_branch"
  log_info "Fetching from origin..."
  git fetch origin "$default_branch"

  local worktree_base
  if [[ -d ".worktrees" ]]; then
    worktree_base=".worktrees"
  elif [[ -d "worktrees" ]]; then
    worktree_base="worktrees"
  else
    worktree_base=".worktrees"
  fi

  if ! git check-ignore -q "$worktree_base" 2>/dev/null; then
    log_warn "$worktree_base not in .gitignore"
  fi

  log_info "Setup complete"
  ralpr_result "{\"status\":\"ready\",\"default_branch\":\"$default_branch\",\"worktree_base\":\"$worktree_base\"}"
  exit 0
}

# ============================================================================
# SUBCOMMAND: select
# ============================================================================

# Helper: check if an issue has unmet dependencies via GitHub's native
# blockedBy relationship (set through sub-issues / issue dependencies UI).
_has_unmet_dependencies() {
  local issue_num="$1"
  local owner repo
  owner=$(get_owner)
  repo=$(get_repo)

  local open_blockers
  open_blockers=$(gh api graphql \
    -f query="$(cat "$QUERIES_DIR/issue-dependencies.graphql")" \
    -f owner="$owner" -f repo="$repo" -F issue="$issue_num" \
    --jq '[.data.repository.issue.blockedBy.nodes[] | select(.state == "OPEN")] | length' 2>/dev/null || echo "0")

  [[ "$open_blockers" -gt 0 ]]
}

# Helper: find incomplete ralpr PRs (need review or refactor below threshold)
# Checks all open unassigned PRs with any ralpr label, not just ralpr:impl:done.
_find_incomplete_ralpr_prs() {
  local dry_run="$1"
  local review_threshold="${REVIEW_THRESHOLD:-85}"
  local refactor_threshold="${REFACTOR_THRESHOLD:-85}"

  while IFS= read -r pr_json; do
    [[ -z "$pr_json" ]] && continue
    local num title review_conf refactor_conf detected_phase
    num=$(echo "$pr_json" | jq -r '.number')
    title=$(echo "$pr_json" | jq -r '.title')

    local has_ralpr_label
    has_ralpr_label=$(echo "$pr_json" | jq -r '[.labels[].name | select(startswith("ralpr:"))] | length')
    [[ "$has_ralpr_label" -eq 0 ]] && continue

    # Extract review confidence
    review_conf=$(echo "$pr_json" | jq -r '
      [.labels[].name | select(test("^ralpr:review:[0-9]+$"))] |
      if length > 0 then .[0] | split(":")[2] | tonumber else 0 end
    ')

    # Extract refactor confidence
    refactor_conf=$(echo "$pr_json" | jq -r '
      [.labels[].name | select(test("^ralpr:refactor:[0-9]+$"))] |
      if length > 0 then .[0] | split(":")[2] | tonumber else 0 end
    ')

    # Check impl:done — if missing, this PR still needs implementation
    local has_impl_done
    has_impl_done=$(echo "$pr_json" | jq -r '[.labels[].name | select(. == "ralpr:impl:done")] | length')
    if [[ "$has_impl_done" -eq 0 ]]; then
      continue  # skip PRs without impl:done — still in implementation
    fi

    if [[ "$review_conf" -lt "$review_threshold" ]]; then
      detected_phase="review"
    elif [[ "$refactor_conf" -lt "$refactor_threshold" ]]; then
      detected_phase="refactor"
    else
      # Both thresholds met — but check for new human feedback
      local owner repo
      owner=$(get_owner)
      repo=$(get_repo)

      # Check if reviewer requested changes — enter at review to read feedback
      local review_decision
      review_decision=$(gh pr view "$num" --json reviewDecision --jq '.reviewDecision // empty' 2>/dev/null)
      if [[ "$review_decision" == "CHANGES_REQUESTED" ]]; then
        detected_phase="review"
        echo "$num|$title|$detected_phase"
        return 0
      fi

      # Check for unresolved review threads — enter at review to read feedback
      local unresolved
      unresolved=$(gh api graphql -f query="$(cat "$QUERIES_DIR/pr-unresolved-threads.graphql")" \
        -f owner="$owner" -f repo="$repo" -F pr="$num" \
        --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' 2>/dev/null || echo "0")
      if [[ "$unresolved" -gt 0 ]]; then
        detected_phase="review"
        echo "$num|$title|$detected_phase"
        return 0
      fi

      continue  # no human feedback, skip
    fi

    # Return this PR
    echo "$num|$title|$detected_phase"
    return 0
  done < <(gh pr list --state open \
    --json number,title,labels,assignees,createdAt \
    --jq '[.[] | select(.assignees | length == 0)] | sort_by(.createdAt) | .[]' 2>/dev/null)

  return 1
}

# Helper: emit the selection result JSON
_emit_select_result() {
  local status="$1" type="$2" num="$3" title="$4" reason="$5" phase="${6:-}"

  local phase_field=""
  if [[ -n "$phase" ]]; then
    phase_field=",\"phase\":\"$phase\""
  fi

  ralpr_result "{\"status\":\"$status\",\"type\":\"$type\",\"number\":$num,\"title\":$(echo "$title" | jq -R .)${phase_field},\"reason\":\"$reason\"}"
}

cmd_select() {
  local issue_num=""
  local pr_num=""
  local dry_run=false
  local phase=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue_num="$2"; shift 2 ;;
      --pr) pr_num="$2"; shift 2 ;;
      --phase) phase="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  local result_status="selected"
  [[ "$dry_run" == "true" ]] && result_status="dry_run"

  # Explicit --pr: validate and return early (skip auto-selection)
  if [[ -n "$pr_num" ]]; then
    local pr_data
    pr_data=$(gh pr view "$pr_num" --json number,title,state,labels 2>/dev/null || echo "")
    if [[ -z "$pr_data" ]]; then
      log_error "PR #$pr_num not found"
      ralpr_result '{"status":"error","code":"not_found","message":"PR not found"}'
      exit 1
    fi

    local pr_title pr_state
    pr_title=$(echo "$pr_data" | jq -r '.title')
    pr_state=$(echo "$pr_data" | jq -r '.state')

    # Auto-detect phase for explicit PR
    local detected_phase=""
    local labels
    labels=$(echo "$pr_data" | jq -r '.labels[].name' 2>/dev/null || echo "")
    local has_impl_done
    has_impl_done=$(echo "$labels" | grep "^ralpr:impl:done$" || echo "")
    if [[ -n "$has_impl_done" ]]; then
      local r_conf=0
      local r_label
      r_label=$(echo "$labels" | grep "^ralpr:review:[0-9]" | head -1 || echo "")
      [[ -n "$r_label" ]] && r_conf=$(echo "$r_label" | grep -oE '[0-9]+$' || echo "0")
      if [[ "$r_conf" -lt "${REVIEW_THRESHOLD:-85}" ]]; then
        detected_phase="review"
      else
        local rf_conf=0
        local rf_label
        rf_label=$(echo "$labels" | grep "^ralpr:refactor:[0-9]" | head -1 || echo "")
        [[ -n "$rf_label" ]] && rf_conf=$(echo "$rf_label" | grep -oE '[0-9]+$' || echo "0")
        if [[ "$rf_conf" -lt "${REFACTOR_THRESHOLD:-85}" ]]; then
          detected_phase="refactor"
        else
          detected_phase="done"
        fi
      fi
    fi

    log_info "Using specified PR #$pr_num: $pr_title (state: $pr_state, phase: ${detected_phase:-unknown})"
    _emit_select_result "$result_status" "pr" "$pr_num" "$pr_title" "specified" "$detected_phase"
    exit 0
  fi

  # Phase-specific PR selection (review or refactor)
  if [[ -n "$phase" ]]; then
    case "$phase" in
      review)
        log_info "Selecting PR for review phase..."
        local selected_pr="" selected_title=""

        while IFS= read -r pr_json; do
          [[ -z "$pr_json" ]] && continue
          local p_num p_title review_conf
          p_num=$(echo "$pr_json" | jq -r '.number')
          p_title=$(echo "$pr_json" | jq -r '.title')
          review_conf=$(echo "$pr_json" | jq -r '
            [.labels[].name | select(test("^ralpr:review:[0-9]+$"))] |
            if length > 0 then .[0] | split(":")[2] | tonumber else 0 end
          ')
          if [[ "$review_conf" -lt "$REVIEW_THRESHOLD" ]]; then
            selected_pr="$p_num"; selected_title="$p_title"; break
          fi
        done < <(gh pr list --state open --label "ralpr:impl:done" \
          --json number,title,labels,assignees,createdAt \
          --jq '[.[] | select(.assignees | length == 0)] | sort_by(.createdAt) | .[]' 2>/dev/null)

        if [[ -z "$selected_pr" ]]; then
          log_info "No PRs available for review"
          ralpr_result '{"status":"none","message":"No PRs ready for review"}'
          exit 1
        fi
        log_info "Selected PR #$selected_pr for review: $selected_title"
        _emit_select_result "$result_status" "pr" "$selected_pr" "$selected_title" "review_needed" "review"
        exit 0
        ;;

      refactor)
        log_info "Selecting PR for refactor phase..."
        local selected_pr="" selected_title=""

        while IFS= read -r pr_json; do
          [[ -z "$pr_json" ]] && continue
          local p_num p_title review_conf refactor_conf
          p_num=$(echo "$pr_json" | jq -r '.number')
          p_title=$(echo "$pr_json" | jq -r '.title')
          review_conf=$(echo "$pr_json" | jq -r '
            [.labels[].name | select(test("^ralpr:review:[0-9]+$"))] |
            if length > 0 then .[0] | split(":")[2] | tonumber else 0 end
          ')
          if [[ "$review_conf" -lt "$REVIEW_THRESHOLD" ]]; then continue; fi
          refactor_conf=$(echo "$pr_json" | jq -r '
            [.labels[].name | select(test("^ralpr:refactor:[0-9]+$"))] |
            if length > 0 then .[0] | split(":")[2] | tonumber else 0 end
          ')
          if [[ "$refactor_conf" -lt "$REFACTOR_THRESHOLD" ]]; then
            selected_pr="$p_num"; selected_title="$p_title"; break
          fi
        done < <(gh pr list --state open \
          --json number,title,labels,assignees,createdAt \
          --jq '[.[] | select(.assignees | length == 0) | select(.labels | map(.name) | any(test("^ralpr:review:[0-9]+$")))] | sort_by(.createdAt) | .[]' 2>/dev/null)

        if [[ -z "$selected_pr" ]]; then
          log_info "No PRs available for refactor"
          ralpr_result '{"status":"none","message":"No PRs ready for refactor"}'
          exit 1
        fi
        log_info "Selected PR #$selected_pr for refactor: $selected_title"
        _emit_select_result "$result_status" "pr" "$selected_pr" "$selected_title" "refactor_needed" "refactor"
        exit 0
        ;;

      *)
        log_error "Unknown phase: $phase (expected 'review' or 'refactor')"
        exit 1
        ;;
    esac
  fi

  if [[ -n "$issue_num" ]]; then
    local title
    title=$(gh issue view "$issue_num" --json title --jq '.title' 2>/dev/null || echo "")
    if [[ -z "$title" ]]; then
      log_error "Issue #$issue_num not found"
      ralpr_result '{"status":"error","code":"not_found","message":"Issue not found"}'
      exit 1
    fi
    log_info "Using specified issue #$issue_num: $title"
    _emit_select_result "$result_status" "issue" "$issue_num" "$title" "specified" "impl"
    exit 0
  fi

  local owner repo
  owner=$(get_owner)
  repo=$(get_repo)

  # ---- Priority 1: Incomplete ralpr PRs (need review/refactor, or have human feedback) ----
  log_info "Checking for incomplete ralpr PRs..."
  local incomplete_result
  if incomplete_result=$(_find_incomplete_ralpr_prs "$dry_run"); then
    local inc_num inc_title inc_phase
    inc_num=$(echo "$incomplete_result" | cut -d'|' -f1)
    inc_title=$(echo "$incomplete_result" | cut -d'|' -f2)
    inc_phase=$(echo "$incomplete_result" | cut -d'|' -f3)

    log_info "Selected PR #$inc_num (incomplete: needs $inc_phase)"
    _emit_select_result "$result_status" "pr" "$inc_num" "$inc_title" "incomplete_${inc_phase}" "$inc_phase"
    exit 0
  fi

  # ---- Priority 2: PRs needing attention (human comments, changes requested, failing CI) ----
  log_info "Checking for PRs needing attention..."
  local prs_needing_attention=()

  while IFS= read -r pr_json; do
    [[ -z "$pr_json" ]] && continue
    local p_num created_at title
    p_num=$(echo "$pr_json" | jq -r '.number')
    created_at=$(echo "$pr_json" | jq -r '.createdAt')
    title=$(echo "$pr_json" | jq -r '.title')

    # Check for unresolved review threads
    local unresolved
    unresolved=$(gh api graphql -f query="$(cat "$QUERIES_DIR/pr-unresolved-threads.graphql")" \
      -f owner="$owner" -f repo="$repo" -F pr="$p_num" \
      --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' 2>/dev/null || echo "0")

    if [[ "$unresolved" -gt 0 ]]; then
      prs_needing_attention+=("$created_at|pr|$p_num|$title|unresolved_comments")
      continue
    fi

    # Check for CHANGES_REQUESTED review decision
    local review_decision
    review_decision=$(gh pr view "$p_num" --json reviewDecision --jq '.reviewDecision // empty' 2>/dev/null)
    if [[ "$review_decision" == "CHANGES_REQUESTED" ]]; then
      prs_needing_attention+=("$created_at|pr|$p_num|$title|changes_requested")
      continue
    fi

    # Check for failing CI
    local ci_status
    ci_status=$(gh pr view "$p_num" --json statusCheckRollup --jq '.statusCheckRollup[] | select(.conclusion == "FAILURE") | .conclusion' 2>/dev/null | head -1)

    if [[ "$ci_status" == "FAILURE" ]]; then
      prs_needing_attention+=("$created_at|pr|$p_num|$title|failing_ci")
    fi
  done < <(gh pr list --state open --json number,title,createdAt,assignees --jq '.[] | select(.assignees | length == 0)' 2>/dev/null)

  if [[ ${#prs_needing_attention[@]} -gt 0 ]]; then
    local selected
    selected=$(printf '%s\n' "${prs_needing_attention[@]}" | sort | head -1)
    local type num title reason
    type=$(echo "$selected" | cut -d'|' -f2)
    num=$(echo "$selected" | cut -d'|' -f3)
    title=$(echo "$selected" | cut -d'|' -f4)
    reason=$(echo "$selected" | cut -d'|' -f5)

    # Detect phase from labels
    local detected_phase=""
    local pr_labels
    pr_labels=$(gh pr view "$num" --json labels --jq '.labels[].name' 2>/dev/null || echo "")
    local has_impl_done
    has_impl_done=$(echo "$pr_labels" | grep "^ralpr:impl:done$" || echo "")
    if [[ -n "$has_impl_done" ]]; then
      local r_conf=0
      local r_label
      r_label=$(echo "$pr_labels" | grep "^ralpr:review:[0-9]" | head -1 || echo "")
      [[ -n "$r_label" ]] && r_conf=$(echo "$r_label" | grep -oE '[0-9]+$' || echo "0")
      if [[ "$r_conf" -lt "${REVIEW_THRESHOLD:-85}" ]]; then
        detected_phase="review"
      else
        local rf_conf=0
        local rf_label
        rf_label=$(echo "$pr_labels" | grep "^ralpr:refactor:[0-9]" | head -1 || echo "")
        [[ -n "$rf_label" ]] && rf_conf=$(echo "$rf_label" | grep -oE '[0-9]+$' || echo "0")
        if [[ "$rf_conf" -lt "${REFACTOR_THRESHOLD:-85}" ]]; then
          detected_phase="refactor"
        else
          detected_phase="review"  # thresholds met but needs attention → review to read feedback
        fi
      fi
    fi
    # No impl:done label → default to review (PR needs work, start from review)
    [[ -z "$detected_phase" ]] && detected_phase="review"

    log_info "Selected $type #$num (attention: $reason, phase: $detected_phase)"
    _emit_select_result "$result_status" "$type" "$num" "$title" "$reason" "$detected_phase"
    exit 0
  fi

  # ---- Priority 3: AI-powered issue selection ----
  # Fetch ALL open, unassigned issues that aren't already in-progress.
  # Use Claude to interpret labels and dependencies instead of requiring
  # hardcoded label names.
  log_info "Evaluating open issues..."
  local all_issues
  all_issues=$(gh issue list --state open --limit 50 \
    --json number,title,labels,body,assignees \
    --jq '[.[] | select(.assignees | length == 0) | select((.labels // []) | map(.name) | all(. != "status:in-progress")) | {number, title, labels: [.labels[].name], body: (.body // "" | .[0:300])}] | sort_by(.number)' 2>/dev/null || echo "[]")

  if [[ -n "$all_issues" && "$all_issues" != "[]" ]]; then
    # Filter out issues that are already being worked on or have unmet dependencies
    local eligible_nums=()
    while IFS= read -r num; do
      [[ -z "$num" ]] && continue
      if _issue_has_open_pr "$num"; then
        log_info "  Skipping #$num: has open PR"
        continue
      fi
      if _has_unmet_dependencies "$num"; then
        log_info "  Skipping #$num: has unmet dependencies"
        continue
      fi
      eligible_nums+=("$num")
    done < <(echo "$all_issues" | jq -r '.[].number')

    if [[ ${#eligible_nums[@]} -gt 0 ]]; then
      # Build filtered JSON with only eligible issues
      local nums_json
      nums_json=$(printf '%s\n' "${eligible_nums[@]}" | jq -R 'tonumber' | jq -s '.')
      local filtered_issues
      filtered_issues=$(echo "$all_issues" | jq --argjson nums "$nums_json" \
        '[.[] | select(.number as $n | $nums | index($n))]')
      local issue_count
      issue_count=$(echo "$filtered_issues" | jq 'length')

      if [[ "$issue_count" -gt 0 ]]; then
        local selected_num=""

        if [[ "$issue_count" -eq 1 ]]; then
          selected_num=$(echo "$filtered_issues" | jq -r '.[0].number')
        else
          # Use Claude (haiku) to interpret labels/dependencies and pick the best issue
          log_info "Using AI to select from $issue_count eligible issues..."
          local ai_prompt
          ai_prompt=$(cat <<SELECTEOF
Select the ONE best GitHub issue to work on next from this list.
Consider:
- Priority: interpret labels intelligently (bug/critical/urgent/high = higher priority)
- Dependencies: if body mentions "depends on #X" or "blocked by #X" where #X is still in this list, skip it
- Prefer bugs and fixes over features when priority is similar
- Prefer smaller/simpler tasks when priorities are equal
- Prefer lower issue numbers (older) as tiebreaker

Issues:
$(echo "$filtered_issues" | jq -c '.[] | {number, title, labels, body}')

Reply with ONLY the issue number. Nothing else.
SELECTEOF
          )
          selected_num=$(claude -p "$ai_prompt" --model haiku 2>/dev/null | grep -oE '[0-9]+' | head -1)
        fi

        if [[ -n "$selected_num" ]]; then
          local sel_title
          sel_title=$(echo "$filtered_issues" | jq -r --argjson n "$selected_num" \
            '.[] | select(.number == $n) | .title')
          if [[ -n "$sel_title" ]]; then
            log_info "Selected issue #$selected_num: $sel_title"
            _emit_select_result "$result_status" "issue" "$selected_num" "$sel_title" "ai_selected" "impl"
            exit 0
          fi
        fi

        # AI failed — fall back to lowest issue number
        log_warn "AI selection failed, falling back to oldest issue"
        selected_num=$(echo "$filtered_issues" | jq -r 'sort_by(.number) | .[0].number')
        local fb_title
        fb_title=$(echo "$filtered_issues" | jq -r --argjson n "$selected_num" \
          '.[] | select(.number == $n) | .title')
        log_info "Selected issue #$selected_num: $fb_title"
        _emit_select_result "$result_status" "issue" "$selected_num" "$fb_title" "fallback_oldest" "impl"
        exit 0
      fi
    fi
  fi

  log_info "No issues available for selection"
  ralpr_result '{"status":"none","message":"No ready tickets found"}'
  exit 1
}

# ============================================================================
# SUBCOMMAND: claim
# ============================================================================
cmd_claim() {
  local type=""
  local number=""

  if [[ $# -lt 2 ]]; then
    log_error "Usage: ralpr claim <issue|pr> <number>"
    exit 1
  fi

  type="$1"
  number="$2"

  case "$type" in
    issue)
      log_info "Claiming issue #$number..."

      local current_user
      current_user=$(gh api user --jq '.login' 2>/dev/null || echo "")

      local assignee_logins
      assignee_logins=$(gh issue view "$number" --json assignees --jq '[.assignees[].login] | join(",")')

      # Already assigned (by us or someone else) — another loop got here first
      if [[ -n "$assignee_logins" ]]; then
        log_error "Issue #$number is already assigned to: $assignee_logins"
        ralpr_result '{"status":"error","code":"already_assigned","message":"Issue already assigned"}'
        exit 1
      fi

      gh issue edit "$number" --add-assignee @me
      gh issue edit "$number" --remove-label "status:backlog" 2>/dev/null || true
      gh issue edit "$number" --add-label "status:in-progress" 2>/dev/null || true

      # Post-claim verification: if another user raced us, back off
      local post_assignees
      post_assignees=$(gh issue view "$number" --json assignees --jq '[.assignees[].login] | join(",")')
      local assignee_count
      assignee_count=$(echo "$post_assignees" | tr ',' '\n' | grep -c . || echo "0")
      if [[ "$assignee_count" -gt 1 ]]; then
        log_warn "Race detected on issue #$number (assignees: $post_assignees), releasing"
        gh issue edit "$number" --remove-assignee @me 2>/dev/null || true
        ralpr_result '{"status":"error","code":"race_detected","message":"Another user claimed simultaneously"}'
        exit 1
      fi

      log_info "Claimed issue #$number"
      ralpr_result "{\"status\":\"claimed\",\"type\":\"issue\",\"number\":$number}"
      ;;

    pr)
      log_info "Claiming PR #$number..."

      local current_user
      current_user=$(gh api user --jq '.login' 2>/dev/null || echo "")

      local assignee_logins
      assignee_logins=$(gh pr view "$number" --json assignees --jq '[.assignees[].login] | join(",")')

      # Already assigned (by us or someone else) — another loop got here first
      if [[ -n "$assignee_logins" ]]; then
        log_error "PR #$number is already assigned to: $assignee_logins"
        ralpr_result '{"status":"error","code":"already_assigned","message":"PR already assigned"}'
        exit 1
      fi

      gh pr edit "$number" --add-assignee @me

      # Post-claim verification: if another user raced us, back off
      local post_assignees
      post_assignees=$(gh pr view "$number" --json assignees --jq '[.assignees[].login] | join(",")')
      local assignee_count
      assignee_count=$(echo "$post_assignees" | tr ',' '\n' | grep -c . || echo "0")
      if [[ "$assignee_count" -gt 1 ]]; then
        log_warn "Race detected on PR #$number (assignees: $post_assignees), releasing"
        gh pr edit "$number" --remove-assignee @me 2>/dev/null || true
        ralpr_result '{"status":"error","code":"race_detected","message":"Another user claimed simultaneously"}'
        exit 1
      fi

      log_info "Claimed PR #$number"
      ralpr_result "{\"status\":\"claimed\",\"type\":\"pr\",\"number\":$number}"
      ;;

    *)
      log_error "Unknown type: $type (expected 'issue' or 'pr')"
      exit 1
      ;;
  esac

  exit 0
}

# ============================================================================
# SUBCOMMAND: branch
# ============================================================================
cmd_branch() {
  local issue_num=""
  local title_slug=""
  local worktree_base=".worktrees"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue_num="$2"; shift 2 ;;
      --title) title_slug="$2"; shift 2 ;;
      --worktree-base) worktree_base="$2"; shift 2 ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  if [[ -z "$issue_num" ]]; then
    log_error "Usage: ralpr branch --issue <number> [--title <slug>]"
    exit 1
  fi

  if [[ -z "$title_slug" ]]; then
    local raw_title
    raw_title=$(gh issue view "$issue_num" --json title --jq '.title')
    title_slug=$(slugify "$raw_title")
  fi

  local branch_name="feature/${issue_num}-${title_slug}"
  local default_branch
  default_branch=$(get_base_branch)

  log_info "Creating branch: $branch_name"

  local worktree_path="$worktree_base/$branch_name"

  mkdir -p "$worktree_base"

  if git worktree list | grep -q "$worktree_path"; then
    log_warn "Worktree already exists at $worktree_path"
    ralpr_result "{\"status\":\"exists\",\"branch\":\"$branch_name\",\"worktree\":true,\"worktree_path\":\"$worktree_path\"}"
    exit 0
  fi

  log_info "Creating worktree at $worktree_path..."
  git worktree add "$worktree_path" -b "$branch_name" "origin/$default_branch"

  if [[ $? -ne 0 ]]; then
    log_error "Failed to create worktree"
    ralpr_result '{"status":"error","code":"worktree_fail","message":"Failed to create worktree"}'
    exit 1
  fi

  log_info "Worktree created at $worktree_path"
  ralpr_result "{\"status\":\"created\",\"branch\":\"$branch_name\",\"worktree\":true,\"worktree_path\":\"$worktree_path\"}"

  exit 0
}

# ============================================================================
# SUBCOMMAND: ci (simplified - delegates to ci-watcher.sh)
# ============================================================================
cmd_ci() {
  source "$SCRIPT_DIR/lib/ci-watcher.sh"

  local action=""
  local run_num=""
  local branch=""
  local timeout=600

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr ci <wait|logs|status> [options]"
    exit 1
  fi

  action="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run) run_num="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --timeout) timeout="$2"; shift 2 ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  if [[ -z "$branch" ]]; then
    branch=$(git branch --show-current)
  fi

  case "$action" in
    status)
      local summary
      summary=$(get_ci_summary "$branch")
      echo "$summary"
      ;;
    wait)
      wait_for_ci "$branch" "$timeout"
      ;;
    logs)
      get_failed_logs "$run_num" "$branch"
      ;;
    *)
      log_error "Unknown action: $action"
      exit 1
      ;;
  esac
}

# ============================================================================
# SUBCOMMAND: pr
# ============================================================================
cmd_pr() {
  local action=""

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr pr <check-conflicts|create|verify> [options]"
    exit 1
  fi

  action="$1"
  shift

  case "$action" in
    check-conflicts)
      local base=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --base) base="$2"; shift 2 ;;
          *) log_error "Unknown option: $1"; return 1 ;;
        esac
      done

      if [[ -z "$base" ]]; then
        base=$(get_base_branch)
      fi

      log_info "Checking for merge conflicts with $base..."
      git fetch origin "$base"

      local merge_base
      merge_base=$(git merge-base HEAD "origin/$base")

      if git merge-tree "$merge_base" HEAD "origin/$base" | grep -q "^<<<<<<<"; then
        log_error "Merge conflicts detected with $base"
        ralpr_result '{"status":"conflicts","message":"Merge conflicts exist with base branch"}'
        exit 1
      fi

      log_info "No merge conflicts"
      ralpr_result '{"status":"clean"}'
      exit 0
      ;;

    create)
      local issue_num=""
      local title=""
      local body=""
      local base=""
      local draft=false

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --issue) issue_num="$2"; shift 2 ;;
          --title) title="$2"; shift 2 ;;
          --body) body="$2"; shift 2 ;;
          --base) base="$2"; shift 2 ;;
          --draft) draft=true; shift ;;
          *) log_error "Unknown option: $1"; return 1 ;;
        esac
      done

      if [[ -z "$base" ]]; then
        base=$(get_base_branch)
      fi

      log_info "Creating PR..."

      local pr_args=("--base" "$base")
      [[ -n "$title" ]] && pr_args+=("--title" "$title")
      [[ -n "$body" ]] && pr_args+=("--body" "$body")
      [[ "$draft" == "true" ]] && pr_args+=("--draft")

      local pr_url
      pr_url=$(gh pr create "${pr_args[@]}")

      if [[ $? -ne 0 ]]; then
        log_error "Failed to create PR"
        ralpr_result '{"status":"error","code":"create_fail","message":"Failed to create PR"}'
        exit 2
      fi

      local pr_number
      pr_number=$(echo "$pr_url" | grep -oE '[0-9]+$')

      log_info "PR created: $pr_url"
      ralpr_result "{\"status\":\"created\",\"url\":\"$pr_url\",\"number\":$pr_number}"
      exit 0
      ;;

    verify)
      local pr_number=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --pr) pr_number="$2"; shift 2 ;;
          *) log_error "Unknown option: $1"; return 1 ;;
        esac
      done

      if [[ -z "$pr_number" ]]; then
        log_error "Usage: ralpr pr verify --pr <number>"
        exit 1
      fi

      log_info "Verifying PR #$pr_number..."
      sleep 3

      local merge_state
      merge_state=$(gh pr view "$pr_number" --json mergeStateStatus --jq '.mergeStateStatus')

      if [[ "$merge_state" == "DIRTY" ]]; then
        log_error "GitHub reports PR has merge conflicts"
        ralpr_result '{"status":"conflicts","message":"GitHub reports merge conflicts"}'
        exit 1
      fi

      log_info "PR is mergeable (state: $merge_state)"
      ralpr_result "{\"status\":\"verified\",\"merge_state\":\"$merge_state\"}"
      exit 0
      ;;

    *)
      log_error "Unknown action: $action"
      exit 1
      ;;
  esac
}

# ============================================================================
# SUBCOMMAND: release
# ============================================================================
cmd_release() {
  local type=""
  local number=""

  if [[ $# -lt 2 ]]; then
    log_error "Usage: ralpr release <issue|pr> <number>"
    exit 1
  fi

  type="$1"
  number="$2"

  case "$type" in
    issue)
      log_info "Releasing assignment from issue #$number..."
      gh issue edit "$number" --remove-assignee @me
      gh issue edit "$number" --remove-label "status:in-progress" 2>/dev/null || true
      gh issue edit "$number" --add-label "status:backlog" 2>/dev/null || true
      log_info "Released issue #$number"
      ralpr_result "{\"status\":\"released\",\"type\":\"issue\",\"number\":$number}"
      ;;

    pr)
      log_info "Releasing assignment from PR #$number..."
      gh pr edit "$number" --remove-assignee @me
      log_info "Released PR #$number"
      ralpr_result "{\"status\":\"released\",\"type\":\"pr\",\"number\":$number}"
      ;;

    *)
      log_error "Unknown type: $type"
      exit 1
      ;;
  esac

  exit 0
}

# ============================================================================
# SUBCOMMAND: loop (super-loop management)
# ============================================================================
cmd_loop() {
  source "$SCRIPT_DIR/lib/loop-state.sh"
  source "$SCRIPT_DIR/lib/tmux.sh"

  if [[ $# -lt 1 ]]; then
    cmd_loop_help
    exit 1
  fi

  local action="$1"
  shift

  case "$action" in
    start) cmd_loop_start "$@" ;;
    stop) cmd_loop_stop "$@" ;;
    status|list) cmd_loop_status "$@" ;;
    clean) cmd_loop_clean "$@" ;;
    attach) cmd_loop_attach "$@" ;;
    logs) cmd_loop_logs "$@" ;;
    help|--help|-h) cmd_loop_help ;;
    *)
      log_error "Unknown loop action: $action"
      cmd_loop_help
      exit 1
      ;;
  esac
}

cmd_loop_help() {
  cat << 'EOF'
ralpr loop - Super Loop: continuous impl→review→refactor pipeline

Usage: ralpr loop <action> [options]

Actions:
  start [--issue N] [--pr N] [--max-cycles N]
      Start a new loop in a tmux pane
      --issue N    Start from a specific issue (impl phase)
      --pr N       Start from a specific PR (auto-detect phase)
      Note: --issue and --pr are mutually exclusive

  stop <loop-id> [--force]
      Stop a running loop (graceful or forced)

  status
      Show status of all loops

  list
      Alias for status

  clean
      Remove dead loops from the registry (releases GitHub assignments)

  attach
      Attach to the tmux monitoring session

  logs <loop-id> [--follow]
      View logs for a loop

Examples:
  ralpr loop start --issue 42 --max-cycles 3
  ralpr loop start --pr 87 --max-cycles 1     # resume from PR
  ralpr loop start                              # auto-select ticket
  ralpr loop status
  ralpr loop clean
  ralpr loop attach
  ralpr loop logs loop-1
  ralpr loop logs loop-1 --follow
  ralpr loop stop loop-2
  ralpr loop stop loop-3 --force
EOF
}

cmd_loop_start() {
  local issue=""
  local pr=""
  local max_cycles="${RALPR_LOOP_MAX_CYCLES:-0}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue="$2"; shift 2 ;;
      --pr) pr="$2"; shift 2 ;;
      --max-cycles) max_cycles="$2"; shift 2 ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  if [[ -n "$issue" && -n "$pr" ]]; then
    log_error "Cannot specify both --issue and --pr"
    return 1
  fi

  # Check tmux
  check_tmux || exit 1

  # Ensure session exists
  ensure_session || exit 1

  # Get next loop ID
  local loop_num
  loop_num=$(next_loop_id)
  local loop_id="loop-${loop_num}"

  log_info "Starting loop: $loop_id"

  # Build the superloop command — pass caller's PWD so the pane runs in the right repo
  local superloop_cmd="cd $(printf '%q' "$PWD") && $SCRIPT_DIR/ralpr-superloop.sh --loop-id $loop_id"
  [[ -n "$issue" ]] && superloop_cmd+=" --issue $issue"
  [[ -n "$pr" ]] && superloop_cmd+=" --pr $pr"
  superloop_cmd+=" --max-cycles $max_cycles"

  # Add pane and start the orchestrator
  local pane_id
  pane_id=$(add_pane "$superloop_cmd")

  # Rebalance layout
  rebalance_layout

  # Get the PID of the process in the pane
  local pane_pid
  pane_pid=$(tmux display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null || echo "0")

  # Register in the loop registry
  register_loop "$loop_id" "$pane_pid" "$pane_id"

  # Set initial pane title
  set_pane_title "$pane_id" "$loop_id: starting"

  log_info "Loop $loop_id started in pane $pane_id"
  log_info "Use 'ralpr loop attach' to monitor"

  ralpr_result "{\"status\":\"started\",\"loop_id\":\"$loop_id\",\"pane_id\":\"$pane_id\"}"
}

cmd_loop_stop() {
  local loop_id=""
  local force=false

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr loop stop <loop-id> [--force]"
    exit 1
  fi

  loop_id="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  local state
  state=$(read_loop_state "$loop_id")

  if [[ "$state" == "{}" ]]; then
    log_error "Loop $loop_id not found"
    exit 1
  fi

  if [[ "$force" == "true" ]]; then
    log_info "Force-stopping loop $loop_id..."

    # Kill any Docker containers matching this loop's pattern
    local containers
    containers=$(docker ps --filter "name=ralpr-${loop_id}" --format '{{.Names}}' 2>/dev/null || echo "")
    for container in $containers; do
      log_info "Killing container: $container"
      docker kill "$container" 2>/dev/null || true
    done

    # Kill the tmux pane
    local registry
    registry=$(_loop_registry_file)
    if [[ -f "$registry" ]]; then
      local pane_id
      pane_id=$(jq -r --arg id "$loop_id" '.loops[$id].tmux_pane // empty' "$registry")
      if [[ -n "$pane_id" ]]; then
        kill_pane "$pane_id"
      fi
    fi

    # Cleanup
    cleanup_loop "$loop_id"
    log_info "Loop $loop_id force-stopped"
    ralpr_result "{\"status\":\"force_stopped\",\"loop_id\":\"$loop_id\"}"
  else
    log_info "Sending stop signal to loop $loop_id..."
    create_stop_signal "$loop_id"
    log_info "Loop $loop_id will stop after the current phase completes"
    ralpr_result "{\"status\":\"stop_signaled\",\"loop_id\":\"$loop_id\"}"
  fi
}

cmd_loop_status() {
  init_loop_registry

  local loops
  loops=$(list_all_loops)

  if [[ -z "$loops" ]]; then
    log_info "No loops registered"
    ralpr_result '{"status":"empty","loops":[]}'
    return 0
  fi

  # Print header
  printf "%-8s | %-10s | %-12s | %-7s | %s\n" "ID" "Issue/PR" "Phase" "Cycle" "Status"
  printf "%-8s-+-%-10s-+-%-12s-+-%-7s-+-%s\n" "--------" "----------" "------------" "-------" "--------"

  while IFS= read -r loop_json; do
    [[ -z "$loop_json" ]] && continue

    local id issue pr phase phase_iter cycle max_cycles status
    id=$(echo "$loop_json" | jq -r '.id // "?"')
    issue=$(echo "$loop_json" | jq -r '.issue // empty')
    pr=$(echo "$loop_json" | jq -r '.pr // empty')
    phase=$(echo "$loop_json" | jq -r '.phase // "—"')
    phase_iter=$(echo "$loop_json" | jq -r '.phase_iteration // empty')
    cycle=$(echo "$loop_json" | jq -r '.cycle // 0')
    max_cycles=$(echo "$loop_json" | jq -r '.max_cycles // 0')
    status=$(echo "$loop_json" | jq -r '.status // "unknown"')

    # Format issue/pr column
    local issue_pr="—"
    if [[ -n "$issue" && -n "$pr" ]]; then
      issue_pr="#${issue}/PR#${pr}"
    elif [[ -n "$issue" ]]; then
      issue_pr="#${issue}"
    elif [[ -n "$pr" ]]; then
      issue_pr="PR#${pr}"
    fi

    # Format phase column
    local phase_display="$phase"
    if [[ -n "$phase_iter" && "$phase_iter" != "null" ]]; then
      phase_display="${phase}:${phase_iter}"
    fi

    # Format cycle column
    local cycle_display="${cycle}/${max_cycles}"

    printf "%-8s | %-10s | %-12s | %-7s | %s\n" "$id" "$issue_pr" "$phase_display" "$cycle_display" "$status"
  done <<< "$loops"
}

cmd_loop_clean() {
  init_loop_registry

  local purged
  purged=$(purge_dead_loops)

  if [[ "$purged" -eq 0 ]]; then
    log_info "No dead loops to clean up"
  else
    log_info "Purged $purged dead loop(s)"
  fi

  ralpr_result "{\"status\":\"cleaned\",\"purged\":$purged}"
}

cmd_loop_attach() {
  attach_session
}

cmd_loop_logs() {
  local loop_id=""
  local follow=false

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr loop logs <loop-id> [--follow]"
    exit 1
  fi

  loop_id="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --follow|-f) follow=true; shift ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  local log_dir="${RALPR_LOOP_LOG_DIR:-.ralpr/logs}/${loop_id}"

  if [[ ! -d "$log_dir" ]]; then
    log_error "No logs found for $loop_id"
    exit 1
  fi

  if [[ "$follow" == "true" ]]; then
    # Find the most recent log file and tail it
    local latest_log
    latest_log=$(find "$log_dir" -name '*.log' -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)

    # Fallback for macOS (no -printf)
    if [[ -z "$latest_log" ]]; then
      latest_log=$(find "$log_dir" -name '*.log' -type f | xargs ls -t 2>/dev/null | head -1)
    fi

    if [[ -z "$latest_log" ]]; then
      log_error "No log files found in $log_dir"
      exit 1
    fi

    log_info "Tailing: $latest_log"
    tail -f "$latest_log"
  else
    # Cat the most recent log file
    local latest_log
    latest_log=$(find "$log_dir" -name '*.log' -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)

    if [[ -z "$latest_log" ]]; then
      latest_log=$(find "$log_dir" -name '*.log' -type f | xargs ls -t 2>/dev/null | head -1)
    fi

    if [[ -z "$latest_log" ]]; then
      log_error "No log files found in $log_dir"
      exit 1
    fi

    log_info "Showing: $latest_log"
    cat "$latest_log"
  fi
}

# ============================================================================
# PHASE COMMANDS (delegate to phase scripts)
# ============================================================================
cmd_implementation() {
  exec "$SCRIPT_DIR/ralpr-implementation.sh" "$@"
}

cmd_review() {
  exec "$SCRIPT_DIR/ralpr-review.sh" "$@"
}

cmd_refactor() {
  exec "$SCRIPT_DIR/ralpr-refactor.sh" "$@"
}

# ============================================================================
# MAIN
# ============================================================================
show_help() {
  cat << 'EOF'
ralpr - Ralpr CLI v3.0 (Ralph Autonomous Loop for Pull-request Readiness)

Three-phase architecture for autonomous ticket processing:
  Phase 1: Implementation - Implement issues using TDD (no loops)
  Phase 2: Review - AI code review with confidence scoring (single iteration)
  Phase 3: Refactor - Code quality improvements (single iteration)

Usage: ralpr <command> [options]

Phase Commands:
  implementation [--issue N] [--human-review]
      Run Phase 1: Select issue, implement with TDD, create PR

  review [--pr N]
      Run Phase 2: Single review iteration with parallel reviewers

  refactor [--pr N]
      Run Phase 3: Single refactor iteration with refactor skill

Super Loop (host-side orchestration):
  loop start [--issue N] [--pr N] [--max-cycles N]
      Start continuous impl→review→refactor pipeline in tmux
      --pr N: enter at detected phase (review/refactor) for existing PR

  loop stop <id> [--force]
      Stop a loop (graceful or forced)

  loop status / loop list
      Show all loop statuses

  loop clean
      Remove dead loops from registry

  loop attach
      Attach to tmux monitoring session

  loop logs <id> [--follow]
      View loop logs

Utility Commands:
  setup
      Check prerequisites, detect default branch

  select [--issue N] [--pr N] [--phase review|refactor] [--dry-run]
      Select next ticket using priority chain:
        1. Incomplete ralpr PRs (need review/refactor, or have human feedback)
        2. PRs needing attention (human comments, changes requested, failing CI)
        3. Open issues (AI-selected by priority/labels)
      With --phase: select PR ready for review or refactor phase

  claim <issue|pr> <number>
      Assign ticket to self

  branch --issue N [--title SLUG]
      Create feature branch in worktree

  ci <wait|logs|status> [--branch B] [--timeout S]
      CI operations

  pr <check-conflicts|create|verify> [options]
      PR operations

  release <issue|pr> <number>
      Remove assignment from ticket

Full Pipeline:
  ralpr --issue 123                    # Run all phases for issue
  ralpr --pr 456                       # Start from PR (auto-detect phase)

Examples:
  ralpr implementation --issue 123     # Implement specific issue
  ralpr review --pr 456                # Review specific PR
  ralpr refactor                       # Auto-select PR ready for refactor
  ralpr --dry-run                      # Preview selection
  ralpr loop start --issue 42          # Start super loop
  ralpr loop status                    # View all loops
EOF
}

main() {
  if [[ $# -lt 1 ]]; then
    show_help
    exit 1
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    # Phase commands
    implementation|impl) cmd_implementation "$@" ;;
    review) cmd_review "$@" ;;
    refactor) cmd_refactor "$@" ;;

    # Super Loop
    loop) cmd_loop "$@" ;;

    # Utility commands
    setup) cmd_setup "$@" ;;
    select) cmd_select "$@" ;;
    claim) cmd_claim "$@" ;;
    branch) cmd_branch "$@" ;;
    ci) cmd_ci "$@" ;;
    pr) cmd_pr "$@" ;;
    release) cmd_release "$@" ;;

    # Help
    help|--help|-h) show_help ;;

    *)
      log_error "Unknown command: $cmd"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
