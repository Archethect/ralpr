#!/usr/bin/env bash
# ralpr - Ralpr CLI v3.0 (Ralph Autonomous Loop for Pull-request Readiness)
# Three-phase architecture: Implementation → Review → Refactor
# Super Loop: Continuous impl→review→refactor pipeline with tmux monitoring
#
# Usage: ralpr <command> [options]
#
# Commands:
#   implementation   Run Phase 1: Implement an issue (no loops)
#   review           Run Phase 2: Review a PR (loops + confidence)
#   refactor         Run Phase 3: Refactor a PR (loops + confidence)
#   loop             Super Loop: continuous impl→review→refactor pipeline
#   setup            Check prerequisites, detect default branch
#   select           Select next ticket (PR or issue)
#   claim            Assign ticket to self
#   branch           Create feature branch/worktree
#   ci               CI operations (wait, logs, status)
#   pr               PR operations (check-conflicts, create, verify)
#   release          Release assignment from ticket

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QUERIES_DIR="$SCRIPT_DIR/queries"

# Source common functions
source "$SCRIPT_DIR/lib/common.sh"

# Source config (needed by cmd_select --phase for thresholds)
source "$SCRIPT_DIR/../config/ralpr.config.sh"

# ============================================================================
# HELPER: Check if issue has a "done" PR (passing CI, no unresolved comments)
# ============================================================================
issue_has_done_pr() {
  local issue_num="$1"
  local owner repo
  owner=$(get_owner)
  repo=$(get_repo)

  # Find open PRs that are linked to close this issue
  local linked_prs
  linked_prs=$(gh api graphql -f query="$(cat "$QUERIES_DIR/issue-closing-prs.graphql")" \
    -f owner="$owner" -f repo="$repo" -F issue="$issue_num" \
    --jq '.data.repository.issue.closedByPullRequestsReferences.nodes[].number' 2>/dev/null)

  if [[ -z "$linked_prs" ]]; then
    return 1
  fi

  for pr_num in $linked_prs; do
    local unresolved
    unresolved=$(gh api graphql -f query="$(cat "$QUERIES_DIR/pr-unresolved-threads.graphql")" \
      -f owner="$owner" -f repo="$repo" -F pr="$pr_num" \
      --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' 2>/dev/null || echo "0")

    if [[ "$unresolved" -gt 0 ]]; then
      continue
    fi

    local ci_failed
    ci_failed=$(gh pr view "$pr_num" --json statusCheckRollup \
      --jq '.statusCheckRollup[] | select(.conclusion == "FAILURE") | .conclusion' 2>/dev/null | head -1)

    if [[ -z "$ci_failed" ]]; then
      return 0
    fi
  done

  return 1
}

# ============================================================================
# SUBCOMMAND: setup
# ============================================================================
cmd_setup() {
  if [[ $# -gt 0 ]]; then
    log_error "Unknown option: $1"
    return 1
  fi

  log_info "Checking prerequisites..."

  if ! check_gh_auth; then
    ralpr_result '{"status":"error","code":"gh_not_auth","message":"GitHub CLI not authenticated"}'
    exit 1
  fi

  if ! check_git_clean; then
    ralpr_result '{"status":"error","code":"dirty_git","message":"Working directory not clean"}'
    exit 2
  fi

  local default_branch
  default_branch=$(get_base_branch)

  if [[ -z "$default_branch" ]]; then
    log_error "No default branch found on remote"
    ralpr_result '{"status":"error","code":"no_default_branch","message":"No default branch configured on GitHub"}'
    exit 3
  fi

  log_info "Default branch: $default_branch"
  log_info "Fetching from origin..."
  git fetch origin "$default_branch"

  local worktree_base
  if [[ -d ".worktrees" ]]; then
    worktree_base=".worktrees"
  elif [[ -d "worktrees" ]]; then
    worktree_base="worktrees"
  else
    worktree_base=".worktrees"
  fi

  if ! git check-ignore -q "$worktree_base" 2>/dev/null; then
    log_warn "$worktree_base not in .gitignore"
  fi

  log_info "Setup complete"
  ralpr_result "{\"status\":\"ready\",\"default_branch\":\"$default_branch\",\"worktree_base\":\"$worktree_base\"}"
  exit 0
}

# ============================================================================
# SUBCOMMAND: select
# ============================================================================
cmd_select() {
  local issue_num=""
  local pr_num=""
  local dry_run=false
  local phase=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue_num="$2"; shift 2 ;;
      --pr) pr_num="$2"; shift 2 ;;
      --phase) phase="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  # Explicit --pr: validate and return early (skip auto-selection)
  if [[ -n "$pr_num" ]]; then
    local pr_data
    pr_data=$(gh pr view "$pr_num" --json number,title,state,labels 2>/dev/null || echo "")
    if [[ -z "$pr_data" ]]; then
      log_error "PR #$pr_num not found"
      ralpr_result '{"status":"error","code":"not_found","message":"PR not found"}'
      exit 1
    fi

    local pr_title pr_state
    pr_title=$(echo "$pr_data" | jq -r '.title')
    pr_state=$(echo "$pr_data" | jq -r '.state')

    log_info "Using specified PR #$pr_num: $pr_title (state: $pr_state)"
    if [[ "$dry_run" == "true" ]]; then
      ralpr_result "{\"status\":\"dry_run\",\"type\":\"pr\",\"number\":$pr_num,\"title\":$(echo "$pr_title" | jq -R .),\"reason\":\"specified\"}"
    else
      ralpr_result "{\"status\":\"selected\",\"type\":\"pr\",\"number\":$pr_num,\"title\":$(echo "$pr_title" | jq -R .),\"reason\":\"specified\"}"
    fi
    exit 0
  fi

  # Phase-specific PR selection (review or refactor)
  if [[ -n "$phase" ]]; then
    case "$phase" in
      review)
        log_info "Selecting PR for review phase..."
        local selected_pr=""
        local selected_title=""

        # Find open PRs with ralpr:impl:done, unassigned, where review confidence < REVIEW_THRESHOLD (or no review label)
        while IFS= read -r pr_json; do
          [[ -z "$pr_json" ]] && continue
          local pr_num pr_title review_conf
          pr_num=$(echo "$pr_json" | jq -r '.number')
          pr_title=$(echo "$pr_json" | jq -r '.title')

          # Extract review confidence from labels (0 if no review label)
          review_conf=$(echo "$pr_json" | jq -r '
            [.labels[].name | select(test("^ralpr:review:[0-9]+$"))] |
            if length > 0 then .[0] | split(":")[2] | tonumber else 0 end
          ')

          if [[ "$review_conf" -lt "$REVIEW_THRESHOLD" ]]; then
            selected_pr="$pr_num"
            selected_title="$pr_title"
            break
          fi
        done < <(gh pr list --state open --label "ralpr:impl:done" \
          --json number,title,labels,assignees,createdAt \
          --jq '[.[] | select(.assignees | length == 0)] | sort_by(.createdAt) | .[]' 2>/dev/null)

        if [[ -z "$selected_pr" ]]; then
          log_info "No PRs available for review"
          ralpr_result '{"status":"none","message":"No PRs ready for review"}'
          exit 1
        fi

        log_info "Selected PR #$selected_pr for review: $selected_title"
        if [[ "$dry_run" == "true" ]]; then
          ralpr_result "{\"status\":\"dry_run\",\"type\":\"pr\",\"number\":$selected_pr,\"title\":$(echo "$selected_title" | jq -R .),\"reason\":\"review_needed\"}"
        else
          ralpr_result "{\"status\":\"selected\",\"type\":\"pr\",\"number\":$selected_pr,\"title\":$(echo "$selected_title" | jq -R .),\"reason\":\"review_needed\"}"
        fi
        exit 0
        ;;

      refactor)
        log_info "Selecting PR for refactor phase..."
        local selected_pr=""
        local selected_title=""

        # Find open PRs with review confidence >= REVIEW_THRESHOLD, unassigned, where refactor confidence < REFACTOR_THRESHOLD (or no refactor label)
        while IFS= read -r pr_json; do
          [[ -z "$pr_json" ]] && continue
          local pr_num pr_title review_conf refactor_conf
          pr_num=$(echo "$pr_json" | jq -r '.number')
          pr_title=$(echo "$pr_json" | jq -r '.title')

          # Extract review confidence
          review_conf=$(echo "$pr_json" | jq -r '
            [.labels[].name | select(test("^ralpr:review:[0-9]+$"))] |
            if length > 0 then .[0] | split(":")[2] | tonumber else 0 end
          ')

          # Skip if review not done
          if [[ "$review_conf" -lt "$REVIEW_THRESHOLD" ]]; then
            continue
          fi

          # Extract refactor confidence (0 if no refactor label)
          refactor_conf=$(echo "$pr_json" | jq -r '
            [.labels[].name | select(test("^ralpr:refactor:[0-9]+$"))] |
            if length > 0 then .[0] | split(":")[2] | tonumber else 0 end
          ')

          if [[ "$refactor_conf" -lt "$REFACTOR_THRESHOLD" ]]; then
            selected_pr="$pr_num"
            selected_title="$pr_title"
            break
          fi
        done < <(gh pr list --state open \
          --json number,title,labels,assignees,createdAt \
          --jq '[.[] | select(.assignees | length == 0) | select(.labels | map(.name) | any(test("^ralpr:review:[0-9]+$")))] | sort_by(.createdAt) | .[]' 2>/dev/null)

        if [[ -z "$selected_pr" ]]; then
          log_info "No PRs available for refactor"
          ralpr_result '{"status":"none","message":"No PRs ready for refactor"}'
          exit 1
        fi

        log_info "Selected PR #$selected_pr for refactor: $selected_title"
        if [[ "$dry_run" == "true" ]]; then
          ralpr_result "{\"status\":\"dry_run\",\"type\":\"pr\",\"number\":$selected_pr,\"title\":$(echo "$selected_title" | jq -R .),\"reason\":\"refactor_needed\"}"
        else
          ralpr_result "{\"status\":\"selected\",\"type\":\"pr\",\"number\":$selected_pr,\"title\":$(echo "$selected_title" | jq -R .),\"reason\":\"refactor_needed\"}"
        fi
        exit 0
        ;;

      *)
        log_error "Unknown phase: $phase (expected 'review' or 'refactor')"
        exit 1
        ;;
    esac
  fi

  if [[ -n "$issue_num" ]]; then
    local title
    title=$(gh issue view "$issue_num" --json title --jq '.title' 2>/dev/null || echo "")
    if [[ -z "$title" ]]; then
      log_error "Issue #$issue_num not found"
      ralpr_result '{"status":"error","code":"not_found","message":"Issue not found"}'
      exit 1
    fi
    log_info "Using specified issue #$issue_num: $title"
    ralpr_result "{\"status\":\"selected\",\"type\":\"issue\",\"number\":$issue_num,\"title\":$(echo "$title" | jq -R .),\"reason\":\"specified\"}"
    exit 0
  fi

  local owner repo
  owner=$(get_owner)
  repo=$(get_repo)

  # Check for PRs needing attention
  log_info "Checking for PRs needing attention..."
  local prs_needing_attention=()
  local pr_list
  pr_list=$(gh pr list --state open --json number,title,createdAt,assignees --jq '.[] | select(.assignees | length == 0)')

  while IFS= read -r pr_json; do
    [[ -z "$pr_json" ]] && continue
    local pr_num created_at title
    pr_num=$(echo "$pr_json" | jq -r '.number')
    created_at=$(echo "$pr_json" | jq -r '.createdAt')
    title=$(echo "$pr_json" | jq -r '.title')

    local unresolved
    unresolved=$(gh api graphql -f query="$(cat "$QUERIES_DIR/pr-unresolved-threads.graphql")" \
      -f owner="$owner" -f repo="$repo" -F pr="$pr_num" \
      --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' 2>/dev/null || echo "0")

    if [[ "$unresolved" -gt 0 ]]; then
      prs_needing_attention+=("$created_at|pr|$pr_num|$title|unresolved_comments")
      continue
    fi

    local ci_status
    ci_status=$(gh pr view "$pr_num" --json statusCheckRollup --jq '.statusCheckRollup[] | select(.conclusion == "FAILURE") | .conclusion' 2>/dev/null | head -1)

    if [[ "$ci_status" == "FAILURE" ]]; then
      prs_needing_attention+=("$created_at|pr|$pr_num|$title|failing_ci")
    fi
  done < <(gh pr list --state open --json number,title,createdAt,assignees --jq '.[] | select(.assignees | length == 0)' 2>/dev/null)

  # Check for bug issues
  log_info "Checking for bug issues..."
  local bug_issues=()
  local bug_labels=("bug" "type:bug" "kind:bug")

  for label in "${bug_labels[@]}"; do
    while IFS= read -r issue_json; do
      [[ -z "$issue_json" ]] && continue
      local num title
      num=$(echo "$issue_json" | jq -r '.number')
      title=$(echo "$issue_json" | jq -r '.title')

      if issue_has_done_pr "$num"; then
        continue
      fi

      bug_issues+=("$num|issue|$num|$title|bug")
    done < <(gh issue list --state open --label "$label" --json number,title,assignees \
      --jq '.[] | select(.assignees | length == 0)' 2>/dev/null)
  done

  # Deduplicate bugs
  local unique_bugs=()
  local seen_nums=""
  if [[ ${#bug_issues[@]} -gt 0 ]]; then
    for bug in "${bug_issues[@]}"; do
      local num
      num=$(echo "$bug" | cut -d'|' -f3)
      if [[ ! "$seen_nums" =~ (^|,)"$num"(,|$) ]]; then
        unique_bugs+=("$bug")
        seen_nums="$seen_nums,$num"
      fi
    done
  fi
  bug_issues=("${unique_bugs[@]+"${unique_bugs[@]}"}")

  # Combine precedence pool
  local precedence_pool=()
  precedence_pool+=("${prs_needing_attention[@]+"${prs_needing_attention[@]}"}")
  precedence_pool+=("${bug_issues[@]+"${bug_issues[@]}"}")

  if [[ ${#precedence_pool[@]} -gt 0 ]]; then
    local selected
    selected=$(printf '%s\n' "${precedence_pool[@]}" | sort | head -1)

    local type num title reason
    type=$(echo "$selected" | cut -d'|' -f2)
    num=$(echo "$selected" | cut -d'|' -f3)
    title=$(echo "$selected" | cut -d'|' -f4)
    reason=$(echo "$selected" | cut -d'|' -f5)

    log_info "Selected $type #$num (precedence: $reason)"

    if [[ "$dry_run" == "true" ]]; then
      ralpr_result "{\"status\":\"dry_run\",\"type\":\"$type\",\"number\":$num,\"title\":$(echo "$title" | jq -R .),\"reason\":\"$reason\"}"
    else
      ralpr_result "{\"status\":\"selected\",\"type\":\"$type\",\"number\":$num,\"title\":$(echo "$title" | jq -R .),\"reason\":\"$reason\"}"
    fi
    exit 0
  fi

  # Check feature issues by priority
  log_info "Checking feature issues..."
  local feature_issues=()
  local priority_labels=("priority:p0" "P0" "priority:p1" "P1" "priority:p2" "P2")

  for label in "${priority_labels[@]}"; do
    while IFS= read -r issue_json; do
      [[ -z "$issue_json" ]] && continue
      local num title
      num=$(echo "$issue_json" | jq -r '.number')
      title=$(echo "$issue_json" | jq -r '.title')

      local body
      body=$(gh issue view "$num" --json body --jq '.body' 2>/dev/null || echo "")
      local has_unmet_deps=false

      if [[ "$body" =~ [Dd]epends\ on:?\ *#([0-9]+) ]]; then
        local dep_num="${BASH_REMATCH[1]}"
        local dep_state
        dep_state=$(gh issue view "$dep_num" --json state --jq '.state' 2>/dev/null || echo "OPEN")
        if [[ "$dep_state" != "CLOSED" ]]; then
          has_unmet_deps=true
        fi
      fi

      if [[ "$has_unmet_deps" == "false" ]]; then
        if issue_has_done_pr "$num"; then
          continue
        fi

        local priority_rank=9
        case "$label" in
          priority:p0|P0) priority_rank=0 ;;
          priority:p1|P1) priority_rank=1 ;;
          priority:p2|P2) priority_rank=2 ;;
        esac
        feature_issues+=("$priority_rank|$num|issue|$num|$title|feature_$label")
      fi
    done < <(gh issue list --state open --label "$label" --json number,title,assignees \
      --jq '.[] | select(.assignees | length == 0)' 2>/dev/null)
  done

  if [[ ${#feature_issues[@]} -gt 0 ]]; then
    local selected
    selected=$(printf '%s\n' "${feature_issues[@]}" | sort -t'|' -k1,1n -k2,2n | head -1)

    local type num title reason
    type=$(echo "$selected" | cut -d'|' -f3)
    num=$(echo "$selected" | cut -d'|' -f4)
    title=$(echo "$selected" | cut -d'|' -f5)
    reason=$(echo "$selected" | cut -d'|' -f6)

    log_info "Selected $type #$num (reason: $reason)"

    if [[ "$dry_run" == "true" ]]; then
      ralpr_result "{\"status\":\"dry_run\",\"type\":\"$type\",\"number\":$num,\"title\":$(echo "$title" | jq -R .),\"reason\":\"$reason\"}"
    else
      ralpr_result "{\"status\":\"selected\",\"type\":\"$type\",\"number\":$num,\"title\":$(echo "$title" | jq -R .),\"reason\":\"$reason\"}"
    fi
    exit 0
  fi

  log_info "No issues available for selection"
  ralpr_result '{"status":"none","message":"No ready tickets found"}'
  exit 1
}

# ============================================================================
# SUBCOMMAND: claim
# ============================================================================
cmd_claim() {
  local type=""
  local number=""

  if [[ $# -lt 2 ]]; then
    log_error "Usage: ralpr claim <issue|pr> <number>"
    exit 1
  fi

  type="$1"
  number="$2"

  case "$type" in
    issue)
      log_info "Claiming issue #$number..."

      local assignees
      assignees=$(gh issue view "$number" --json assignees --jq '.assignees | length')
      if [[ "$assignees" -gt 0 ]]; then
        log_error "Issue #$number is already assigned"
        ralpr_result '{"status":"error","code":"already_assigned","message":"Issue already assigned"}'
        exit 1
      fi

      gh issue edit "$number" --add-assignee @me
      gh issue edit "$number" --remove-label "status:backlog" 2>/dev/null || true
      gh issue edit "$number" --add-label "status:in-progress" 2>/dev/null || true

      log_info "Claimed issue #$number"
      ralpr_result "{\"status\":\"claimed\",\"type\":\"issue\",\"number\":$number}"
      ;;

    pr)
      log_info "Claiming PR #$number..."

      local assignees
      assignees=$(gh pr view "$number" --json assignees --jq '.assignees | length')
      if [[ "$assignees" -gt 0 ]]; then
        log_error "PR #$number is already assigned"
        ralpr_result '{"status":"error","code":"already_assigned","message":"PR already assigned"}'
        exit 1
      fi

      gh pr edit "$number" --add-assignee @me
      log_info "Claimed PR #$number"
      ralpr_result "{\"status\":\"claimed\",\"type\":\"pr\",\"number\":$number}"
      ;;

    *)
      log_error "Unknown type: $type (expected 'issue' or 'pr')"
      exit 1
      ;;
  esac

  exit 0
}

# ============================================================================
# SUBCOMMAND: branch
# ============================================================================
cmd_branch() {
  local issue_num=""
  local title_slug=""
  local worktree_base=".worktrees"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue_num="$2"; shift 2 ;;
      --title) title_slug="$2"; shift 2 ;;
      --worktree-base) worktree_base="$2"; shift 2 ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  if [[ -z "$issue_num" ]]; then
    log_error "Usage: ralpr branch --issue <number> [--title <slug>]"
    exit 1
  fi

  if [[ -z "$title_slug" ]]; then
    local raw_title
    raw_title=$(gh issue view "$issue_num" --json title --jq '.title')
    title_slug=$(slugify "$raw_title")
  fi

  local branch_name="feature/${issue_num}-${title_slug}"
  local default_branch
  default_branch=$(get_base_branch)

  log_info "Creating branch: $branch_name"

  local worktree_path="$worktree_base/$branch_name"

  mkdir -p "$worktree_base"

  if git worktree list | grep -q "$worktree_path"; then
    log_warn "Worktree already exists at $worktree_path"
    ralpr_result "{\"status\":\"exists\",\"branch\":\"$branch_name\",\"worktree\":true,\"worktree_path\":\"$worktree_path\"}"
    exit 0
  fi

  log_info "Creating worktree at $worktree_path..."
  git worktree add "$worktree_path" -b "$branch_name" "origin/$default_branch"

  if [[ $? -ne 0 ]]; then
    log_error "Failed to create worktree"
    ralpr_result '{"status":"error","code":"worktree_fail","message":"Failed to create worktree"}'
    exit 1
  fi

  log_info "Worktree created at $worktree_path"
  ralpr_result "{\"status\":\"created\",\"branch\":\"$branch_name\",\"worktree\":true,\"worktree_path\":\"$worktree_path\"}"

  exit 0
}

# ============================================================================
# SUBCOMMAND: ci (simplified - delegates to ci-watcher.sh)
# ============================================================================
cmd_ci() {
  source "$SCRIPT_DIR/lib/ci-watcher.sh"

  local action=""
  local run_num=""
  local branch=""
  local timeout=600

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr ci <wait|logs|status> [options]"
    exit 1
  fi

  action="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run) run_num="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --timeout) timeout="$2"; shift 2 ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  if [[ -z "$branch" ]]; then
    branch=$(git branch --show-current)
  fi

  case "$action" in
    status)
      local summary
      summary=$(get_ci_summary "$branch")
      echo "$summary"
      ;;
    wait)
      wait_for_ci "$branch" "$timeout"
      ;;
    logs)
      get_failed_logs "$run_num" "$branch"
      ;;
    *)
      log_error "Unknown action: $action"
      exit 1
      ;;
  esac
}

# ============================================================================
# SUBCOMMAND: pr
# ============================================================================
cmd_pr() {
  local action=""

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr pr <check-conflicts|create|verify> [options]"
    exit 1
  fi

  action="$1"
  shift

  case "$action" in
    check-conflicts)
      local base=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --base) base="$2"; shift 2 ;;
          *) log_error "Unknown option: $1"; return 1 ;;
        esac
      done

      if [[ -z "$base" ]]; then
        base=$(get_base_branch)
      fi

      log_info "Checking for merge conflicts with $base..."
      git fetch origin "$base"

      local merge_base
      merge_base=$(git merge-base HEAD "origin/$base")

      if git merge-tree "$merge_base" HEAD "origin/$base" | grep -q "^<<<<<<<"; then
        log_error "Merge conflicts detected with $base"
        ralpr_result '{"status":"conflicts","message":"Merge conflicts exist with base branch"}'
        exit 1
      fi

      log_info "No merge conflicts"
      ralpr_result '{"status":"clean"}'
      exit 0
      ;;

    create)
      local issue_num=""
      local title=""
      local body=""
      local base=""
      local draft=false

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --issue) issue_num="$2"; shift 2 ;;
          --title) title="$2"; shift 2 ;;
          --body) body="$2"; shift 2 ;;
          --base) base="$2"; shift 2 ;;
          --draft) draft=true; shift ;;
          *) log_error "Unknown option: $1"; return 1 ;;
        esac
      done

      if [[ -z "$base" ]]; then
        base=$(get_base_branch)
      fi

      log_info "Creating PR..."

      local pr_args=("--base" "$base")
      [[ -n "$title" ]] && pr_args+=("--title" "$title")
      [[ -n "$body" ]] && pr_args+=("--body" "$body")
      [[ "$draft" == "true" ]] && pr_args+=("--draft")

      local pr_url
      pr_url=$(gh pr create "${pr_args[@]}")

      if [[ $? -ne 0 ]]; then
        log_error "Failed to create PR"
        ralpr_result '{"status":"error","code":"create_fail","message":"Failed to create PR"}'
        exit 2
      fi

      local pr_number
      pr_number=$(echo "$pr_url" | grep -oE '[0-9]+$')

      log_info "PR created: $pr_url"
      ralpr_result "{\"status\":\"created\",\"url\":\"$pr_url\",\"number\":$pr_number}"
      exit 0
      ;;

    verify)
      local pr_number=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --pr) pr_number="$2"; shift 2 ;;
          *) log_error "Unknown option: $1"; return 1 ;;
        esac
      done

      if [[ -z "$pr_number" ]]; then
        log_error "Usage: ralpr pr verify --pr <number>"
        exit 1
      fi

      log_info "Verifying PR #$pr_number..."
      sleep 3

      local merge_state
      merge_state=$(gh pr view "$pr_number" --json mergeStateStatus --jq '.mergeStateStatus')

      if [[ "$merge_state" == "DIRTY" ]]; then
        log_error "GitHub reports PR has merge conflicts"
        ralpr_result '{"status":"conflicts","message":"GitHub reports merge conflicts"}'
        exit 1
      fi

      log_info "PR is mergeable (state: $merge_state)"
      ralpr_result "{\"status\":\"verified\",\"merge_state\":\"$merge_state\"}"
      exit 0
      ;;

    *)
      log_error "Unknown action: $action"
      exit 1
      ;;
  esac
}

# ============================================================================
# SUBCOMMAND: release
# ============================================================================
cmd_release() {
  local type=""
  local number=""

  if [[ $# -lt 2 ]]; then
    log_error "Usage: ralpr release <issue|pr> <number>"
    exit 1
  fi

  type="$1"
  number="$2"

  case "$type" in
    issue)
      log_info "Releasing assignment from issue #$number..."
      gh issue edit "$number" --remove-assignee @me
      gh issue edit "$number" --remove-label "status:in-progress" 2>/dev/null || true
      gh issue edit "$number" --add-label "status:backlog" 2>/dev/null || true
      log_info "Released issue #$number"
      ralpr_result "{\"status\":\"released\",\"type\":\"issue\",\"number\":$number}"
      ;;

    pr)
      log_info "Releasing assignment from PR #$number..."
      gh pr edit "$number" --remove-assignee @me
      log_info "Released PR #$number"
      ralpr_result "{\"status\":\"released\",\"type\":\"pr\",\"number\":$number}"
      ;;

    *)
      log_error "Unknown type: $type"
      exit 1
      ;;
  esac

  exit 0
}

# ============================================================================
# SUBCOMMAND: loop (super-loop management)
# ============================================================================
cmd_loop() {
  source "$SCRIPT_DIR/lib/loop-state.sh"
  source "$SCRIPT_DIR/lib/tmux.sh"

  if [[ $# -lt 1 ]]; then
    cmd_loop_help
    exit 1
  fi

  local action="$1"
  shift

  case "$action" in
    start) cmd_loop_start "$@" ;;
    stop) cmd_loop_stop "$@" ;;
    status|list) cmd_loop_status "$@" ;;
    attach) cmd_loop_attach "$@" ;;
    logs) cmd_loop_logs "$@" ;;
    help|--help|-h) cmd_loop_help ;;
    *)
      log_error "Unknown loop action: $action"
      cmd_loop_help
      exit 1
      ;;
  esac
}

cmd_loop_help() {
  cat << 'EOF'
ralpr loop - Super Loop: continuous impl→review→refactor pipeline

Usage: ralpr loop <action> [options]

Actions:
  start [--issue N] [--max-cycles N]
      Start a new loop in a tmux pane

  stop <loop-id> [--force]
      Stop a running loop (graceful or forced)

  status
      Show status of all loops

  list
      Alias for status

  attach
      Attach to the tmux monitoring session

  logs <loop-id> [--follow]
      View logs for a loop

Examples:
  ralpr loop start --issue 42 --max-cycles 3
  ralpr loop start                              # auto-select issue
  ralpr loop status
  ralpr loop attach
  ralpr loop logs loop-1
  ralpr loop logs loop-1 --follow
  ralpr loop stop loop-2
  ralpr loop stop loop-3 --force
EOF
}

cmd_loop_start() {
  local issue=""
  local max_cycles="${RALPR_LOOP_MAX_CYCLES:-0}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue="$2"; shift 2 ;;
      --max-cycles) max_cycles="$2"; shift 2 ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  # Check tmux
  check_tmux || exit 1

  # Ensure session exists
  ensure_session || exit 1

  # Get next loop ID
  local loop_num
  loop_num=$(next_loop_id)
  local loop_id="loop-${loop_num}"

  log_info "Starting loop: $loop_id"

  # Build the superloop command
  local superloop_cmd="$SCRIPT_DIR/ralpr-superloop.sh --loop-id $loop_id"
  [[ -n "$issue" ]] && superloop_cmd+=" --issue $issue"
  superloop_cmd+=" --max-cycles $max_cycles"

  # Add pane and start the orchestrator
  local pane_id
  pane_id=$(add_pane "$superloop_cmd")

  # Rebalance layout
  rebalance_layout

  # Get the PID of the process in the pane
  local pane_pid
  pane_pid=$(tmux display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null || echo "0")

  # Register in the loop registry
  register_loop "$loop_id" "$pane_pid" "$pane_id"

  # Set initial pane title
  set_pane_title "$pane_id" "$loop_id: starting"

  log_info "Loop $loop_id started in pane $pane_id"
  log_info "Use 'ralpr loop attach' to monitor"

  ralpr_result "{\"status\":\"started\",\"loop_id\":\"$loop_id\",\"pane_id\":\"$pane_id\"}"
}

cmd_loop_stop() {
  local loop_id=""
  local force=false

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr loop stop <loop-id> [--force]"
    exit 1
  fi

  loop_id="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  local state
  state=$(read_loop_state "$loop_id")

  if [[ "$state" == "{}" ]]; then
    log_error "Loop $loop_id not found"
    exit 1
  fi

  if [[ "$force" == "true" ]]; then
    log_info "Force-stopping loop $loop_id..."

    # Kill any Docker containers matching this loop's pattern
    local containers
    containers=$(docker ps --filter "name=ralpr-${loop_id}" --format '{{.Names}}' 2>/dev/null || echo "")
    for container in $containers; do
      log_info "Killing container: $container"
      docker kill "$container" 2>/dev/null || true
    done

    # Kill the tmux pane
    local registry
    registry=$(_loop_registry_file)
    if [[ -f "$registry" ]]; then
      local pane_id
      pane_id=$(jq -r --arg id "$loop_id" '.loops[$id].tmux_pane // empty' "$registry")
      if [[ -n "$pane_id" ]]; then
        kill_pane "$pane_id"
      fi
    fi

    # Cleanup
    cleanup_loop "$loop_id"
    log_info "Loop $loop_id force-stopped"
    ralpr_result "{\"status\":\"force_stopped\",\"loop_id\":\"$loop_id\"}"
  else
    log_info "Sending stop signal to loop $loop_id..."
    create_stop_signal "$loop_id"
    log_info "Loop $loop_id will stop after the current phase completes"
    ralpr_result "{\"status\":\"stop_signaled\",\"loop_id\":\"$loop_id\"}"
  fi
}

cmd_loop_status() {
  init_loop_registry

  local loops
  loops=$(list_all_loops)

  if [[ -z "$loops" ]]; then
    log_info "No loops registered"
    ralpr_result '{"status":"empty","loops":[]}'
    return 0
  fi

  # Print header
  printf "%-8s | %-10s | %-12s | %-7s | %s\n" "ID" "Issue/PR" "Phase" "Cycle" "Status"
  printf "%-8s-+-%-10s-+-%-12s-+-%-7s-+-%s\n" "--------" "----------" "------------" "-------" "--------"

  while IFS= read -r loop_json; do
    [[ -z "$loop_json" ]] && continue

    local id issue pr phase phase_iter cycle max_cycles status
    id=$(echo "$loop_json" | jq -r '.id // "?"')
    issue=$(echo "$loop_json" | jq -r '.issue // empty')
    pr=$(echo "$loop_json" | jq -r '.pr // empty')
    phase=$(echo "$loop_json" | jq -r '.phase // "—"')
    phase_iter=$(echo "$loop_json" | jq -r '.phase_iteration // empty')
    cycle=$(echo "$loop_json" | jq -r '.cycle // 0')
    max_cycles=$(echo "$loop_json" | jq -r '.max_cycles // 0')
    status=$(echo "$loop_json" | jq -r '.status // "unknown"')

    # Format issue/pr column
    local issue_pr="—"
    if [[ -n "$issue" && -n "$pr" ]]; then
      issue_pr="#${issue}/PR#${pr}"
    elif [[ -n "$issue" ]]; then
      issue_pr="#${issue}"
    elif [[ -n "$pr" ]]; then
      issue_pr="PR#${pr}"
    fi

    # Format phase column
    local phase_display="$phase"
    if [[ -n "$phase_iter" && "$phase_iter" != "null" ]]; then
      phase_display="${phase}:${phase_iter}"
    fi

    # Format cycle column
    local cycle_display="${cycle}/${max_cycles}"

    printf "%-8s | %-10s | %-12s | %-7s | %s\n" "$id" "$issue_pr" "$phase_display" "$cycle_display" "$status"
  done <<< "$loops"
}

cmd_loop_attach() {
  attach_session
}

cmd_loop_logs() {
  local loop_id=""
  local follow=false

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr loop logs <loop-id> [--follow]"
    exit 1
  fi

  loop_id="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --follow|-f) follow=true; shift ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  local log_dir="${RALPR_LOOP_LOG_DIR:-.ralpr/logs}/${loop_id}"

  if [[ ! -d "$log_dir" ]]; then
    log_error "No logs found for $loop_id"
    exit 1
  fi

  if [[ "$follow" == "true" ]]; then
    # Find the most recent log file and tail it
    local latest_log
    latest_log=$(find "$log_dir" -name '*.log' -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)

    # Fallback for macOS (no -printf)
    if [[ -z "$latest_log" ]]; then
      latest_log=$(find "$log_dir" -name '*.log' -type f | xargs ls -t 2>/dev/null | head -1)
    fi

    if [[ -z "$latest_log" ]]; then
      log_error "No log files found in $log_dir"
      exit 1
    fi

    log_info "Tailing: $latest_log"
    tail -f "$latest_log"
  else
    # Cat the most recent log file
    local latest_log
    latest_log=$(find "$log_dir" -name '*.log' -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)

    if [[ -z "$latest_log" ]]; then
      latest_log=$(find "$log_dir" -name '*.log' -type f | xargs ls -t 2>/dev/null | head -1)
    fi

    if [[ -z "$latest_log" ]]; then
      log_error "No log files found in $log_dir"
      exit 1
    fi

    log_info "Showing: $latest_log"
    cat "$latest_log"
  fi
}

# ============================================================================
# PHASE COMMANDS (delegate to phase scripts)
# ============================================================================
cmd_implementation() {
  exec "$SCRIPT_DIR/ralpr-implementation.sh" "$@"
}

cmd_review() {
  exec "$SCRIPT_DIR/ralpr-review.sh" "$@"
}

cmd_refactor() {
  exec "$SCRIPT_DIR/ralpr-refactor.sh" "$@"
}

# ============================================================================
# MAIN
# ============================================================================
show_help() {
  cat << 'EOF'
ralpr - Ralpr CLI v3.0 (Ralph Autonomous Loop for Pull-request Readiness)

Three-phase architecture for autonomous ticket processing:
  Phase 1: Implementation - Implement issues using TDD (no loops)
  Phase 2: Review - AI code review with confidence scoring (single iteration)
  Phase 3: Refactor - Code quality improvements (single iteration)

Usage: ralpr <command> [options]

Phase Commands:
  implementation [--issue N] [--human-review]
      Run Phase 1: Select issue, implement with TDD, create PR

  review [--pr N]
      Run Phase 2: Single review iteration with parallel reviewers

  refactor [--pr N]
      Run Phase 3: Single refactor iteration with refactor skill

Super Loop (host-side orchestration):
  loop start [--issue N] [--max-cycles N]
      Start continuous impl→review→refactor pipeline in tmux

  loop stop <id> [--force]
      Stop a loop (graceful or forced)

  loop status / loop list
      Show all loop statuses

  loop attach
      Attach to tmux monitoring session

  loop logs <id> [--follow]
      View loop logs

Utility Commands:
  setup
      Check prerequisites, detect default branch

  select [--issue N] [--phase review|refactor] [--dry-run]
      Select next ticket (PRs with comments/failing CI > bugs > features)
      With --phase: select PR ready for review or refactor phase

  claim <issue|pr> <number>
      Assign ticket to self

  branch --issue N [--title SLUG]
      Create feature branch in worktree

  ci <wait|logs|status> [--branch B] [--timeout S]
      CI operations

  pr <check-conflicts|create|verify> [options]
      PR operations

  release <issue|pr> <number>
      Remove assignment from ticket

Full Pipeline:
  ralpr --issue 123                    # Run all phases for issue
  ralpr --pr 456                       # Start from PR (auto-detect phase)

Examples:
  ralpr implementation --issue 123     # Implement specific issue
  ralpr review --pr 456                # Review specific PR
  ralpr refactor                       # Auto-select PR ready for refactor
  ralpr --dry-run                      # Preview selection
  ralpr loop start --issue 42          # Start super loop
  ralpr loop status                    # View all loops
EOF
}

main() {
  if [[ $# -lt 1 ]]; then
    show_help
    exit 1
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    # Phase commands
    implementation|impl) cmd_implementation "$@" ;;
    review) cmd_review "$@" ;;
    refactor) cmd_refactor "$@" ;;

    # Super Loop
    loop) cmd_loop "$@" ;;

    # Utility commands
    setup) cmd_setup "$@" ;;
    select) cmd_select "$@" ;;
    claim) cmd_claim "$@" ;;
    branch) cmd_branch "$@" ;;
    ci) cmd_ci "$@" ;;
    pr) cmd_pr "$@" ;;
    release) cmd_release "$@" ;;

    # Help
    help|--help|-h) show_help ;;

    *)
      log_error "Unknown command: $cmd"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
