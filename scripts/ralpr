#!/usr/bin/env bash
# ralpr - Ralpr CLI v4.0 (Ralph Autonomous Loop for Pull-request Readiness)
# Thin wrapper that delegates to the TypeScript orchestrator.
#
# Usage: ralpr <command> [options]
#
# Commands:
#   start    Launch the orchestrator
#   stop     Gracefully stop the orchestrator
#   status   Show active teams and queue
#   attach   Attach to the tmux monitoring session
#   logs     Tail logs for an issue
#   bugs     List agent-filed bugs
#   cleanup  Remove stale worktrees and exited containers
#   rebuild  Rebuild the Docker image

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="${SCRIPT_DIR%/scripts}"

# Source common functions
source "$SCRIPT_DIR/lib/common.sh"

# Source config
source "$PLUGIN_DIR/config/ralpr.config.sh"

PID_FILE="${RALPR_OUTPUT_DIR}/orchestrator.pid"

# ============================================================================
# SUBCOMMAND: start
# ============================================================================
cmd_start() {
  local max_teams="$RALPR_MAX_PARALLEL_TEAMS"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-teams) max_teams="$2"; shift 2 ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    log_error "Orchestrator already running (PID $(cat "$PID_FILE"))"
    exit 1
  fi

  mkdir -p "$RALPR_OUTPUT_DIR"

  log_info "Starting orchestrator (max-teams=$max_teams)..."
  RALPR_MAX_PARALLEL_TEAMS="$max_teams" \
    npx tsx "$PLUGIN_DIR/src/orchestrator.ts" &
  local pid=$!
  echo "$pid" > "$PID_FILE"

  log_info "Orchestrator started (PID $pid)"
  ralpr_result "{\"status\":\"started\",\"pid\":$pid}"
}

# ============================================================================
# SUBCOMMAND: stop
# ============================================================================
cmd_stop() {
  local force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  if [[ ! -f "$PID_FILE" ]]; then
    log_error "No PID file found — orchestrator not running?"
    exit 1
  fi

  local pid
  pid=$(cat "$PID_FILE")

  if ! kill -0 "$pid" 2>/dev/null; then
    log_warn "Process $pid not running, cleaning up PID file"
    rm -f "$PID_FILE"
    exit 0
  fi

  if [[ "$force" == "true" ]]; then
    log_warn "Force-killing orchestrator (PID $pid)..."
    kill -9 "$pid" 2>/dev/null || true
  else
    log_info "Sending SIGTERM to orchestrator (PID $pid)..."
    kill "$pid" 2>/dev/null || true
  fi

  rm -f "$PID_FILE"
  log_info "Orchestrator stopped"
  ralpr_result '{"status":"stopped"}'
}

# ============================================================================
# SUBCOMMAND: status
# ============================================================================
cmd_status() {
  if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    local pid
    pid=$(cat "$PID_FILE")
    log_info "Orchestrator running (PID $pid)"

    # Show tmux session info if available
    if tmux has-session -t "$RALPR_TMUX_SESSION" 2>/dev/null; then
      log_info "tmux session: $RALPR_TMUX_SESSION"
      tmux list-panes -t "$RALPR_TMUX_SESSION" -F "  #{pane_index}: #{pane_title}" 2>/dev/null || true
    fi

    ralpr_result "{\"status\":\"running\",\"pid\":$pid}"
  else
    log_info "Orchestrator not running"
    [[ -f "$PID_FILE" ]] && rm -f "$PID_FILE"
    ralpr_result '{"status":"stopped"}'
  fi
}

# ============================================================================
# SUBCOMMAND: attach
# ============================================================================
cmd_attach() {
  if ! tmux has-session -t "$RALPR_TMUX_SESSION" 2>/dev/null; then
    log_error "No tmux session '$RALPR_TMUX_SESSION' found"
    exit 1
  fi

  exec tmux attach-session -t "$RALPR_TMUX_SESSION"
}

# ============================================================================
# SUBCOMMAND: logs
# ============================================================================
cmd_logs() {
  local issue_num=""
  local follow=false

  if [[ $# -lt 1 ]]; then
    log_error "Usage: ralpr logs <issue-number> [--follow]"
    exit 1
  fi

  issue_num="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --follow|-f) follow=true; shift ;;
      *) log_error "Unknown option: $1"; return 1 ;;
    esac
  done

  local log_file="$RALPR_OUTPUT_DIR/issues/${issue_num}/agent.log"

  if [[ ! -f "$log_file" ]]; then
    log_error "No logs found for issue #$issue_num"
    exit 1
  fi

  if [[ "$follow" == "true" ]]; then
    tail -f "$log_file"
  else
    cat "$log_file"
  fi
}

# ============================================================================
# SUBCOMMAND: bugs
# ============================================================================
cmd_bugs() {
  local subcmd="${1:-list}"

  case "$subcmd" in
    list)
      gh issue list --label "filed-by-agent" --json number,title,state,labels \
        --template '{{range .}}#{{.number}} [{{.state}}] {{.title}}{{"\n"}}{{end}}'
      ;;
    triage)
      gh issue list --label "needs-triage" --json number,title,state,labels \
        --template '{{range .}}#{{.number}} [{{.state}}] {{.title}}{{"\n"}}{{end}}'
      ;;
    *)
      log_error "Unknown bugs subcommand: $subcmd (expected 'list' or 'triage')"
      exit 1
      ;;
  esac
}

# ============================================================================
# SUBCOMMAND: cleanup
# ============================================================================
cmd_cleanup() {
  log_info "Cleaning up stale worktrees..."
  git worktree prune 2>/dev/null || true

  log_info "Removing exited containers..."
  docker rm "$(docker ps -aq --filter 'status=exited' --filter 'label=ralpr')" 2>/dev/null || true

  log_info "Cleanup complete"
  ralpr_result '{"status":"cleaned"}'
}

# ============================================================================
# SUBCOMMAND: rebuild
# ============================================================================
cmd_rebuild() {
  log_info "Building Docker image..."
  docker build -t ralpr "$PLUGIN_DIR"
  log_info "Build complete"
  ralpr_result '{"status":"built"}'
}

# ============================================================================
# MAIN
# ============================================================================
show_help() {
  cat << 'EOF'
ralpr - Ralpr CLI v4.0 (Ralph Autonomous Loop for Pull-request Readiness)

Agent Teams orchestrator for autonomous issue processing.

Usage: ralpr <command> [options]

Commands:
  start [--max-teams N]
      Launch the TypeScript orchestrator (default: 3 parallel teams)

  stop [--force]
      Gracefully stop the orchestrator (SIGTERM), or --force (SIGKILL)

  status
      Show orchestrator state, active teams, and tmux session info

  attach
      Attach to the tmux monitoring session

  logs <issue-number> [--follow]
      Tail agent logs for a specific issue

  bugs [triage]
      List agent-filed bugs, or 'triage' for unreviewed ones

  cleanup
      Remove stale git worktrees and exited Docker containers

  rebuild
      Rebuild the ralpr Docker image

Examples:
  ralpr start                    # Start with defaults
  ralpr start --max-teams 5      # Start with 5 parallel teams
  ralpr stop                     # Graceful shutdown
  ralpr logs 123 --follow        # Stream logs for issue #123
  ralpr bugs triage              # Show bugs needing human review
EOF
}

main() {
  if [[ $# -lt 1 ]]; then
    show_help
    exit 1
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    status)  cmd_status "$@" ;;
    attach)  cmd_attach "$@" ;;
    logs)    cmd_logs "$@" ;;
    bugs)    cmd_bugs "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    rebuild) cmd_rebuild "$@" ;;
    help|--help|-h) show_help ;;
    *)
      log_error "Unknown command: $cmd"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
