{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Understand Agent Output",
  "type": "object",
  "required": ["status", "mode"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "error"]
    },
    "mode": {
      "type": "string",
      "enum": ["issue", "pr"],
      "description": "Which mode the agent ran in"
    },
    "title": {
      "type": "string",
      "description": "Issue or PR title"
    },
    "summary": {
      "type": "string",
      "description": "Brief description (50 words max, PR mode only)"
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of changed files (PR mode only)"
    },
    "patterns_used": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Patterns/abstractions used in the changes (PR mode only)"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of acceptance criteria (AC1: ..., AC2: ...)"
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Implementation constraints (issue mode only)"
    },
    "edge_cases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Edge cases to handle (issue mode only)"
    },
    "definition_of_done": {
      "type": "string",
      "description": "When is this issue considered complete (issue mode only)"
    },
    "commits_count": {
      "type": "integer",
      "description": "Number of commits in PR (PR mode only)"
    },
    "review_status": {
      "type": "string",
      "enum": ["APPROVED", "CHANGES_REQUESTED", "PENDING", "COMMENTED"],
      "description": "GitHub review decision status (PR mode only)"
    },
    "unresolved_comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "comment": { "type": "string" }
        },
        "required": ["file", "comment"]
      },
      "description": "Unresolved review comments (PR mode only)"
    },
    "focus_areas": {
      "type": "object",
      "description": "Guidance for downstream reviewers (PR mode only)",
      "properties": {
        "qa": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Areas for QA reviewer to focus on (test gaps, edge cases, AC verification)"
        },
        "domain": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Areas for domain expert to focus on (architecture, security, patterns)"
        },
        "codex": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Areas for Codex reviewer to focus on (complex logic, potential bugs)"
        }
      },
      "required": ["qa", "domain", "codex"]
    },
    "error": {
      "type": "string"
    }
  }
}
