{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewer Output (code-reviewer/codex)",
  "type": "object",
  "required": ["reviewer", "status", "verdict", "issues"],
  "properties": {
    "reviewer": {
      "type": "string",
      "enum": ["code-reviewer", "codex"]
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "error"]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "issues": {
      "type": "object",
      "properties": {
        "critical": {
          "type": "array",
          "items": { "$ref": "#/definitions/issue" }
        },
        "important": {
          "type": "array",
          "items": { "$ref": "#/definitions/issue" }
        },
        "minor": {
          "type": "array",
          "items": { "$ref": "#/definitions/issue" }
        }
      },
      "required": ["critical", "important", "minor"]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ac_id": { "type": "string" },
          "status": { "enum": ["pass", "fail", "partial"] },
          "notes": { "type": "string" }
        },
        "required": ["ac_id", "status"]
      }
    },
    "error": {
      "type": "string",
      "description": "Error message if status is error"
    },
    "error_code": {
      "type": "string",
      "description": "Machine-readable error code (e.g. codex_unavailable)"
    }
  },
  "definitions": {
    "issue": {
      "type": "object",
      "required": ["id", "severity", "title", "location"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(CR|CDX)-[CIM][0-9]{3}$"
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
        },
        "category": {
          "enum": ["bug", "security", "architecture", "convention", "performance", "testing", "accessibility", "logic"]
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "line_start": { "type": "integer" },
            "line_end": { "type": "integer" }
          },
          "required": ["file"]
        },
        "suggested_fix": { "type": "string" },
        "proposed_fix": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "diff": { "type": "string" }
          }
        }
      }
    }
  }
}
