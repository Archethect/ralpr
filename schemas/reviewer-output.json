{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewer Output (QA/Domain/Codex)",
  "type": "object",
  "required": ["reviewer", "status", "verdict", "issues"],
  "properties": {
    "reviewer": {
      "type": "string",
      "enum": ["qa", "domain", "codex"]
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "error"]
    },
    "verdict": {
      "type": "string",
      "enum": ["APPROVED", "NEEDS_CHANGES"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall confidence in the review"
    },
    "issues": {
      "type": "object",
      "properties": {
        "critical": {
          "type": "array",
          "items": { "$ref": "#/definitions/issue" }
        },
        "important": {
          "type": "array",
          "items": { "$ref": "#/definitions/issue" }
        },
        "minor": {
          "type": "array",
          "items": { "$ref": "#/definitions/issue" }
        }
      },
      "required": ["critical", "important", "minor"]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ac_id": { "type": "string" },
          "status": { "enum": ["pass", "fail", "partial"] },
          "notes": { "type": "string" }
        },
        "required": ["ac_id", "status"]
      }
    },
    "error": {
      "type": "string",
      "description": "Error message if status is error"
    }
  },
  "definitions": {
    "issue": {
      "type": "object",
      "required": ["id", "title", "location"],
      "properties": {
        "id": { "type": "string", "pattern": "^(QA|DOM|CDX)-[CIM][0-9]{3}$" },
        "category": { "enum": ["testing", "edge-case", "error-handling", "security", "architecture", "convention", "performance", "bug", "logic"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "line_start": { "type": "integer" },
            "line_end": { "type": "integer" }
          },
          "required": ["file"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "proposed_fix": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "diff": { "type": "string" }
          }
        }
      }
    }
  }
}
