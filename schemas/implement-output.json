{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Implement Agent Output",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "error"]
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_summary": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer" },
        "failed": { "type": "integer" }
      }
    },
    "error": {
      "type": "string"
    },
    "partial_progress": {
      "type": "string",
      "description": "What was completed before failure"
    }
  }
}
